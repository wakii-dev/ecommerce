# Ecommerce platform — env template.
# Copy: cp .env.example .env   (compose đọc tự động; services đọc qua shell/export)
# KHÔNG commit .env thật. Secrets chỉ sống ở đây + CI secrets.

# ── Postgres (1 container, DB-per-service) ─────────────────────────────
# Host DB từ máy dev: localhost:5433 (container nội bộ vẫn 5432; máy này
# có postgres compose khác giữ 5432 — đổi PG_HOST_PORT nếu machine khác)
PG_HOST_PORT=5433
SPRING_DATASOURCE_URL_IDENTITY=jdbc:postgresql://localhost:5433/db_identity
SPRING_DATASOURCE_URL_CATALOG=jdbc:postgresql://localhost:5433/db_catalog
SPRING_DATASOURCE_URL_ORDERING=jdbc:postgresql://localhost:5433/db_ordering
SPRING_DATASOURCE_URL_PAYMENT=jdbc:postgresql://localhost:5433/db_payment
SPRING_DATASOURCE_URL_INVENTORY=jdbc:postgresql://localhost:5433/db_inventory
# SF-12 (FI-322) — affiliate-service (:8092, D20)
SPRING_DATASOURCE_URL_AFFILIATE=jdbc:postgresql://localhost:5433/db_affiliate
AFFILIATE_DEFAULT_RATE=5
AFFILIATE_IP_SALT=dev-affiliate-salt
# db_template = sandbox của template-service (SF-1) — service thật KHÔNG dùng
SPRING_DATASOURCE_URL_TEMPLATE=jdbc:postgresql://localhost:5433/db_template
# Override URL của 1 service: export SPRING_DATASOURCE_URL (service yml đọc
# ${SPRING_DATASOURCE_URL:default-db-của-service}) — hoặc sửa yml khi fork.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── RabbitMQ (AMQP 5672, Management UI 15672) ──────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ── Redis (6379) ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Mailpit (SMTP 1025, UI 8025) — dev email sink ──────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025

# ── MongoDB (D14 — log-service SF-10 dùng; container có từ SF-1) ───────
MONGO_URI=mongodb://localhost:27017

# ── Elasticsearch (D15 — search engine SF-4 dùng; container có từ SF-1) ──
ELASTICSEARCH_URI=http://localhost:9200

# ── Stripe (test mode) — không key → payment-service degraded, không crash ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── JWT RS256 keypair (SF-3 identity dùng; `make keys` sinh infra/keys/) ──
JWT_PRIVATE_KEY_PATH=infra/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=infra/keys/jwt-public.pem

# ── Admin seed (SF-3; SF-10 pack: admin@demo.vn) ────────────────────────
ADMIN_EMAIL=admin@demo.vn
ADMIN_PASSWORD=admin123

# ── Micro frontend remote URLs (shell host → remotes, SF-2 dùng) ───────
REMOTE_STOREFRONT_URL=http://localhost:5174
REMOTE_CHECKOUT_URL=http://localhost:5175
REMOTE_ACCOUNT_URL=http://localhost:5176
REMOTE_ADMIN_URL=http://localhost:5177
# skeleton = harness fixture SF-2 (Task 14) — remote demo chứng minh MF + shared singletons
REMOTE_SKELETON_URL=http://localhost:5178

# ── Ordering saga (SF-9) — command edges tới các service ─────────────────
CATALOG_BASE_URL=http://localhost:8082
# Interim (REQUIREMENT-GAP FI-310 comment 94b8496e): re-price gọi admin-by-id
# của catalog — cần JWT role ADMIN. Đặt token (vd admin login) để chạy demo;
# khi coordinator duyệt internal pricing endpoint thì đổi CATALOG_BY_ID_PATH.
CATALOG_BY_ID_PATH=/api/catalog/admin/products/
CATALOG_API_TOKEN=
INVENTORY_BASE_URL=http://localhost:8084
PAYMENT_BASE_URL=http://localhost:8086

# ── Invoice (D18 — SF-9) ──────────────────────────────────────────────────
INVOICE_SERVICE_URL=http://localhost:8090
INVOICE_MAU_SO=01/001
INVOICE_KY_HIEU=C26
INVOICE_VAT_RATE=10
INVOICE_SELLER_NAME=Cửa hàng Demo Ecommerce
INVOICE_SELLER_ADDRESS=123 Đường Thử Nghiệm, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh
INVOICE_SELLER_PHONE=028 1234 5678
INVOICE_SELLER_TAX_ID=0312345678

# ── SF-6 cart + checkout FE (Vite chỉ expose prefix VITE_*) ────────────
# SF-10 (FI-320): VITE_ORDERING_STUB đã XOÁ — checkout gọi ordering thật
# (POST /api/ordering/orders + poll /me/orders/{id}).
# Flat-fee vận chuyển checkout (VND) — pack ghi SHIPPING_FLAT_FEE, Vite
# không expose biến không-VITE nên dùng prefix VITE_
VITE_SHIPPING_FLAT_FEE=25000
# Publishable key Stripe (pk_test_...) cho Stripe.js confirm — TRỐNG →
# checkout hiện mock pay panel (đơn demo không trừ tiền)
VITE_STRIPE_PUBLISHABLE_KEY=
# Shell origin cho cross-app nav từ Next (MUA NGAY → /cart là trang shell)
# Header Next link /cart, /account + PDP MUA NGAY (trang shell, không phải route Next)
NEXT_PUBLIC_SHELL_URL=http://localhost:5173

# ── Partner Open API (SF-11 — partner-api :8091, db_partner) ─────────────
# Service-account tạo đơn thay partner (GAP-1 interim — REQUIREMENT-GAP
# FI-310): register-once + login qua identity PUBLIC API; khi ordering có
# internal service-token endpoint thì đổi PARTNER_ORDERING_BASE_URL.
PARTNER_IDENTITY_BASE_URL=http://localhost:8081
PARTNER_SERVICE_ACCOUNT_EMAIL=partner-svc@ecommerce.local
PARTNER_SERVICE_ACCOUNT_PASSWORD=PartnerSvc#2026
PARTNER_SERVICE_ACCOUNT_NAME=Partner Orders (service account)
PARTNER_ORDERING_BASE_URL=http://localhost:8085
PARTNER_CATALOG_BASE_URL=http://localhost:8082
# GAP-3 interim: admin-by-id của catalog cần JWT ADMIN — rỗng → partner
# UUID detail trả 502 + nhắn "dùng slug" (giống CATALOG_API_TOKEN ở trên)
CATALOG_API_TOKEN=
PARTNER_WEBHOOK_RETRY_BASE_MS=5000
PARTNER_WEBHOOK_MAX_ATTEMPTS=3
PARTNER_WEBHOOK_SCHEDULER_INTERVAL_MS=5000

# ── SF-10 (FI-320) — notification + log-service + convergence (append 2026-09-07) ──
# notification (email cảm ơn + PDF attach; service-account ADMIN lấy hóa đơn)
NOTIFY_IDENTITY_BASE_URL=http://localhost:8081
NOTIFY_SERVICE_ACCOUNT_EMAIL=notification-svc@ecommerce.local
NOTIFY_SERVICE_ACCOUNT_PASSWORD=NotifySvc#2026
NOTIFY_MAIL_FROM=Ecommerce Demo <no-reply@demo.vn>
NOTIFY_MY_ORDERS_URL=http://localhost:5173/account/orders
ORDERING_BASE_URL=http://localhost:8085
# log-service Mongo (D14) — database event_log
MONGO_DATABASE=db_log
# Demo accounts seed (SF-10) — password dev demo, KHÔNG dùng prod
DEMO_USER_EMAIL=user@demo.vn
DEMO_USER_PASSWORD=Demo#2026

# ── SF-13 (FI-323) — essentials & polish (append per SF) ────────────────
# MinIO object storage (A3 upload ảnh — compose minio :9000/:9001)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
CATALOG_MINIO_ENDPOINT=http://localhost:9000
