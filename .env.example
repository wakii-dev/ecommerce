# Ecommerce platform — env template.
# Copy: cp .env.example .env   (compose đọc tự động; services đọc qua shell/export)
# KHÔNG commit .env thật. Secrets chỉ sống ở đây + CI secrets.

# ── Postgres (1 container, DB-per-service) ─────────────────────────────
# Host DB từ máy dev: localhost:5433 (container nội bộ vẫn 5432; máy này
# có postgres compose khác giữ 5432 — đổi PG_HOST_PORT nếu machine khác)
PG_HOST_PORT=5433
SPRING_DATASOURCE_URL_IDENTITY=jdbc:postgresql://localhost:5433/db_identity
SPRING_DATASOURCE_URL_CATALOG=jdbc:postgresql://localhost:5433/db_catalog
SPRING_DATASOURCE_URL_ORDERING=jdbc:postgresql://localhost:5433/db_ordering
SPRING_DATASOURCE_URL_PAYMENT=jdbc:postgresql://localhost:5433/db_payment
SPRING_DATASOURCE_URL_INVENTORY=jdbc:postgresql://localhost:5433/db_inventory
# db_template = sandbox của template-service (SF-1) — service thật KHÔNG dùng
SPRING_DATASOURCE_URL_TEMPLATE=jdbc:postgresql://localhost:5433/db_template
# Override URL của 1 service: export SPRING_DATASOURCE_URL (service yml đọc
# ${SPRING_DATASOURCE_URL:default-db-của-service}) — hoặc sửa yml khi fork.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── RabbitMQ (AMQP 5672, Management UI 15672) ──────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ── Redis (6379) ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Mailpit (SMTP 1025, UI 8025) — dev email sink ──────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025

# ── MongoDB (D14 — log-service SF-10 dùng; container có từ SF-1) ───────
MONGO_URI=mongodb://localhost:27017

# ── Elasticsearch (D15 — search engine SF-4 dùng; container có từ SF-1) ──
ELASTICSEARCH_URI=http://localhost:9200

# ── Stripe (test mode) — không key → payment-service degraded, không crash ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── JWT RS256 keypair (SF-3 identity dùng; `make keys` sinh infra/keys/) ──
JWT_PRIVATE_KEY_PATH=infra/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=infra/keys/jwt-public.pem

# ── Admin seed (SF-3) ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@ecommerce.local
ADMIN_PASSWORD=admin123

# ── Micro frontend remote URLs (shell host → remotes, SF-2 dùng) ───────
REMOTE_STOREFRONT_URL=http://localhost:5174
REMOTE_CHECKOUT_URL=http://localhost:5175
REMOTE_ACCOUNT_URL=http://localhost:5176
REMOTE_ADMIN_URL=http://localhost:5177
