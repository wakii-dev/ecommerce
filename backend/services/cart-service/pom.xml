<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ecommerce</groupId>
    <artifactId>ecommerce-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>cart-service</artifactId>
  <name>cart-service</name>
  <description>Cart + checkout UX (SF-6) — guest/user cart trên Redis, merge-on-login, enrichment catalog/inventory. KHÔNG DB; SF-10 thêm consumer order.confirmed (clear cart user sau mua) qua RabbitMQ.</description>

  <dependencies>
    <dependency>
      <groupId>com.ecommerce</groupId>
      <artifactId>common-lib</artifactId>
      <exclusions>
        <!-- common-lib compile-level kéo jpa cho outbox; cart KHÔNG có DB (D8)
             → exclude để JPA autoconfig backing-off tự nhiên (classpath honest).
             jakarta.persistence-api giữ lại riêng vì common-lib
             GlobalExceptionHandler reference jakarta.persistence.EntityNotFoundException
             trong @ExceptionHandler.
             SF-10: KHÔNG exclude amqp nữa — consumer order.confirmed clear cart
             (Redis DEL tự idempotent, KHÔNG dùng IdempotentConsumer vì không có
             bảng processed_messages — không DB). -->
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-data-jpa</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Classpath cho @ExceptionHandler reference của common-lib (xem trên) -->
    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Cart state — Redis là store DUY NHẤT (D8: cart không có DB riêng) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- Optional JWT (guest anonymous, user bearer) + merge endpoint authenticated -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- API docs -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- SF-10 IT consumer order.confirmed (RabbitMQContainer — pattern affiliate) -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- WireMock — double catalog/inventory cho enrichment IT (pack: unavailable enrichment) -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>3.9.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <!-- repackage: jar executable (java -jar) — parent pom KHÔNG kế thừa
               spring-boot-starter-parent nên phải khai báo tay.compose profile
               full + scripts/dev-stack.sh chạy java -jar (SF-10). -->
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
