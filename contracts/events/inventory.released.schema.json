{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.released.schema.json",
  "title": "inventory.released",
  "description": "Nhả reservation khi order CANCELLED (hết TTL hoặc admin hủy) hoặc FAILED. Producer: inventory-service. Kích hoạt qua events order.cancelled / order.failed — không qua REST.",
  "type": "object",
  "required": ["eventId", "eventType", "occurredAt", "correlationId", "producer", "schemaVersion", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v4 — consumer dùng dedupe (idempotent receive)"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z-]+$",
      "const": "inventory.released",
      "description": "Routing key dạng <domain>.<event>"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Thời điểm sự kiện xảy ra (UTC, ISO 8601)"
    },
    "correlationId": {
      "type": "string",
      "description": "Truyền từ header X-Request-Id của gateway"
    },
    "producer": {
      "type": "string",
      "description": "Tên service phát event"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Phiên bản payload schema — additive-only"
    },
    "payload": {
      "type": "object",
      "required": ["reservationId", "orderId", "items"],
      "properties": {
        "reservationId": {
          "type": "string",
          "description": "Id reservation đã nhả"
        },
        "orderId": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["variantId", "qty"],
            "properties": {
              "variantId": {
                "type": "string",
                "description": "Reservation ở mức variant (không phải product)"
              },
              "qty": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
