{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.reserved.schema.json",
  "title": "inventory.reserved",
  "description": "Reservation all-or-nothing thành công (variant-level, TTL mặc định 30'). Publish ra broker cho các consumer cần biết. Producer: inventory-service. Commit/release KHÔNG qua REST — điều khiển qua order.paid / order.cancelled / order.failed.",
  "type": "object",
  "required": ["eventId", "eventType", "occurredAt", "correlationId", "producer", "schemaVersion", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v4 — consumer dùng dedupe (idempotent receive)"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z-]+$",
      "const": "inventory.reserved",
      "description": "Routing key dạng <domain>.<event>"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Thời điểm sự kiện xảy ra (UTC, ISO 8601)"
    },
    "correlationId": {
      "type": "string",
      "description": "Truyền từ header X-Request-Id của gateway"
    },
    "producer": {
      "type": "string",
      "description": "Tên service phát event"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Phiên bản payload schema — additive-only"
    },
    "payload": {
      "type": "object",
      "required": ["reservationId", "orderId", "items"],
      "properties": {
        "reservationId": {
          "type": "string",
          "description": "Id reservation (dùng để release/commit khớp)"
        },
        "orderId": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["variantId", "qty"],
            "properties": {
              "variantId": {
                "type": "string",
                "description": "Reservation ở mức variant (không phải product)"
              },
              "qty": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
