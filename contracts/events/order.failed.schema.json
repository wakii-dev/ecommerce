{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order.failed.schema.json",
  "title": "order.failed",
  "description": "Saga thất bại — inventory release qua event này. Producer: ordering-service.",
  "type": "object",
  "required": ["eventId", "eventType", "occurredAt", "correlationId", "producer", "schemaVersion", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v4 — consumer dùng dedupe (idempotent receive)"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z-]+$",
      "const": "order.failed",
      "description": "Routing key dạng <domain>.<event>"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Thời điểm sự kiện xảy ra (UTC, ISO 8601)"
    },
    "correlationId": {
      "type": "string",
      "description": "Truyền từ header X-Request-Id của gateway"
    },
    "producer": {
      "type": "string",
      "description": "Tên service phát event"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Phiên bản payload schema — additive-only"
    },
    "payload": {
      "type": "object",
      "required": ["orderId", "reason", "stage"],
      "properties": {
        "orderId": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "description": "Lý do thất bại (vd hết stock, coupon race)"
        },
        "stage": {
          "type": "string",
          "enum": ["RESERVE", "PAYMENT", "OTHER"],
          "description": "Bước saga gãy: RESERVE (hết/tồn không đủ), PAYMENT (payment.failed), OTHER"
        }
      }
    }
  }
}
