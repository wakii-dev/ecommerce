{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order.paid.schema.json",
  "title": "order.paid",
  "description": "Đơn đã thanh toán — inventory commit reservation qua event này; COD không phát event này (CONFIRMED sau reserve, PAID lúc giao). Producer: ordering-service.",
  "type": "object",
  "required": ["eventId", "eventType", "occurredAt", "correlationId", "producer", "schemaVersion", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v4 — consumer dùng dedupe (idempotent receive)"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z-]+$",
      "const": "order.paid",
      "description": "Routing key dạng <domain>.<event>"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Thời điểm sự kiện xảy ra (UTC, ISO 8601)"
    },
    "correlationId": {
      "type": "string",
      "description": "Truyền từ header X-Request-Id của gateway"
    },
    "producer": {
      "type": "string",
      "description": "Tên service phát event"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Phiên bản payload schema — additive-only"
    },
    "payload": {
      "type": "object",
      "required": ["orderId", "paymentIntentId", "paidAt"],
      "properties": {
        "orderId": {
          "type": "string"
        },
        "paymentIntentId": {
          "type": "string",
          "description": "Intent đã capture thành công"
        },
        "paidAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
